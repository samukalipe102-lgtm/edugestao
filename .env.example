# Banco de dados (SQLite por padrão; troque por Postgres/MySQL em produção se desejar)
DATABASE_URL="file:./dev.db"

# Segredo do NextAuth — GERE UM NOVO para produção: `openssl rand -base64 32`
NEXTAUTH_SECRET="troque-por-um-segredo-forte"

# URL pública da aplicação
NEXTAUTH_URL="http://localhost:3000"

# (Opcional) credenciais do admin criado pelo seed
# ADMIN_EMAIL="admin@edugestao.local"
# ADMIN_PASSWORD="admin123"

# =============================================================
# EduGestão — variáveis de ambiente (exemplo)
# Copie para .env e ajuste. NUNCA versione o .env real.
# Todos os segredos vêm daqui — nada é embutido no código.
# =============================================================

# -------- Banco de dados --------
# DESENVOLVIMENTO LOCAL (padrão do schema): SQLite
DATABASE_URL="file:./dev.db"
#
# PRODUÇÃO (ex.: Vercel + Neon/Supabase/Vercel Postgres): PostgreSQL.
# Antes do deploy, troque o provider do schema com:  npm run db:use:postgres
# e defina a connection string do seu provedor, por exemplo:
# DATABASE_URL="postgresql://usuario:senha@host:5432/edugestao?sslmode=require"

# -------- Autenticação (NextAuth) --------
# Segredo para assinar as sessões. GERE UM NOVO para produção:
#   openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-um-segredo-forte-em-producao"

# URL pública da aplicação.
# Local: http://localhost:3000   |   Produção: https://SEU-DOMINIO
NEXTAUTH_URL="http://localhost:3000"

# -------- Administrador inicial (usado pelo seed: npm run db:seed) --------
# Opcionais em dev (há um padrão). OBRIGATÓRIO ADMIN_PASSWORD em produção.
# ADMIN_EMAIL="admin@suaescola.edu.br"
# ADMIN_PASSWORD="defina-uma-senha-forte"
